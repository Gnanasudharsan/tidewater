# Copy to .env (make init does this). Local-only dev credentials; never reuse elsewhere.
COMPOSE_PROJECT_NAME=tidewater

SRC_PG_USER=tidewater
SRC_PG_PASSWORD=tidewater
SRC_PG_DB=shop

WH_PG_USER=warehouse
WH_PG_PASSWORD=warehouse
WH_PG_DB=analytics

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=tidewater
S3_SECRET_KEY=tidewater-dev-secret
LAKEHOUSE_BUCKET=lakehouse

# Simulator
SIM_EVENTS_PER_SEC=20
SIM_SEED_CUSTOMERS=200
SIM_SEED_PRODUCTS=100
