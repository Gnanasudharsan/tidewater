# Copy to .env (make init does this). Local-only dev credentials; never reuse elsewhere.
COMPOSE_PROJECT_NAME=tidewater

SRC_PG_USER=tidewater
SRC_PG_PASSWORD=tidewater
SRC_PG_DB=shop

WH_PG_USER=warehouse
WH_PG_PASSWORD=warehouse
WH_PG_DB=analytics
# Host port for the warehouse (5433 is often taken by another local Postgres).
WH_PG_HOST_PORT=5434

S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=tidewater
S3_SECRET_KEY=tidewater-dev-secret
LAKEHOUSE_BUCKET=lakehouse

# Simulator
SIM_EVENTS_PER_SEC=20
SIM_SEED_CUSTOMERS=200
SIM_SEED_PRODUCTS=100

# Metabase admin for the LOCAL dashboard only (created by scripts/metabase_setup.py).
MB_ADMIN_EMAIL=admin@tidewater.local
MB_ADMIN_PASSWORD=Tidewater-dev-change-me-1

# Grafana admin (LOCAL only; anonymous users get read-only access).
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Where alerts go. Default: the local alert-sink. Set to a Slack/Discord webhook to page a human.
GRAFANA_ALERT_WEBHOOK_URL=http://alert-sink:9000/

# Emit OpenLineage events to Marquez (make up-lineage). Leave empty to disable.
OPENLINEAGE_URL=
MARQUEZ_HOST_PORT=5005
